# ──────────────────────────────────────────────
# Environment Variables
# ──────────────────────────────────────────────
# Copy this file to `.env` and fill in the values.
#   cp .env.example .env
#
# Anything under runtimeConfig.public is exposed to the client bundle.
# Everything else is server-only.
# Mirror every variable you add here in nuxt.config.ts → runtimeConfig.
# ──────────────────────────────────────────────

# ─── Site ─────────────────────────────────────
# Public base URL, no trailing slash. Drives canonicals, og:url, the
# sitemap and every absolute link in JSON-LD. Inlined at build time via
# vite.define, so a change needs a rebuild — not just a restart.
NUXT_SITE_URL=https://jewelrybox.ng

# ─── Analytics ────────────────────────────────
# GA4 measurement ID. The gtag script is only downloaded after a visitor
# grants consent (see app/composables/useTag.ts). Leave blank to disable.
NUXT_PUBLIC_GTAG_ID=

# ─── Supabase ─────────────────────────────────
# URL and anon key are safe in the client bundle — RLS is what protects the
# data, and the anon key is meant to be public. Locally these come from
# `supabase start`; the CLI prints them, and `supabase status` repeats them.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=

# SERVER ONLY. Bypasses every RLS policy. Never expose it under
# runtimeConfig.public, never log it, never send it to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# ─── Email (Resend) ───────────────────────────
# Leave RESEND_API_KEY blank in development: sendOrderEmails() logs and skips
# rather than sending, and local Supabase catches auth mail in Inbucket at
# http://127.0.0.1:54324. In production this needs a verified sending domain —
# see the resend:email-best-practices skill for SPF/DKIM/DMARC.
RESEND_API_KEY=

# Must be on a domain verified in Resend (jewelrybox.ng is). Note that Resend
# verifies a domain for SENDING — it adds no MX records, so this address receives
# nothing. Customer replies are steered to VENDOR_EMAIL via reply-to instead; set
# up inbound or forwarding if you want hello@ to be a real mailbox.
# Quoted: the angle brackets are shell redirection if anyone sources this file.
FROM_EMAIL="JewelryBox <hello@jewelrybox.ng>"

# A real inbox someone reads. Order notifications go here, and it is also the
# reply-to on every customer email.
VENDOR_EMAIL=

# ─── Supabase auth (read by the CLI, not by Nuxt) ─────────────────
# Interpolated into supabase/config.toml by the CLI. Kept out of the file itself
# so `supabase config push` cannot write localhost into the hosted project's auth
# settings and break every confirmation link. In production these are the real
# origin: https://jewelrybox.ng and https://jewelrybox.ng/**
SUPABASE_AUTH_SITE_URL=http://localhost:3000
SUPABASE_AUTH_REDIRECT_GLOB=http://localhost:3000/**
