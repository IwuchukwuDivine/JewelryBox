# ──────────────────────────────────────────────
# Environment Variables
# ──────────────────────────────────────────────
# Copy this file to `.env` and fill in the values.
#   cp .env.example .env
#
# Anything under runtimeConfig.public is exposed to the client bundle.
# Everything else is server-only.
# Mirror every variable you add here in nuxt.config.ts → runtimeConfig.
# ──────────────────────────────────────────────

# ─── Site ─────────────────────────────────────
# Public base URL. Used for canonical links, SEO, sitemap, and emails.
SITE_URL=https://example.com

# ─── Add your services below ──────────────────
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_ANON_KEY=eyJ...
# RESEND_API_KEY=re_...
