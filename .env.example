# ──────────────────────────────────────────────
# Environment Variables
# ──────────────────────────────────────────────
# Copy this file to `.env` and fill in the values.
#   cp .env.example .env
#
# Anything under runtimeConfig.public is exposed to the client bundle.
# Everything else is server-only.
# Mirror every variable you add here in nuxt.config.ts → runtimeConfig.
# ──────────────────────────────────────────────

# ─── Site ─────────────────────────────────────
# Public base URL, no trailing slash. Drives canonicals, og:url, the
# sitemap and every absolute link in JSON-LD. Inlined at build time via
# vite.define, so a change needs a rebuild — not just a restart.
NUXT_SITE_URL=https://jewelrybox.ng

# ─── Analytics ────────────────────────────────
# GA4 measurement ID. The gtag script is only downloaded after a visitor
# grants consent (see app/composables/useTag.ts). Leave blank to disable.
NUXT_PUBLIC_GTAG_ID=

# ─── Supabase ─────────────────────────────────
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_ANON_KEY=eyJ...
# SUPABASE_SERVICE_ROLE_KEY=eyJ...
